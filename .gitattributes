# Normalizar saltos de línea
* text=auto

# Asegurar UTF-8 y LF en archivos de código
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf

# Tratar imágenes como binarios
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary